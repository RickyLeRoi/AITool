# .env.example — template for local configuration.
#
# This file is where every default lives now - core/local_llm_client.py has
# NO hardcoded fallback values in code anymore. If a variable below is
# unset (neither here nor in the real environment), the tool that needs it
# reports "[local-llm not configured]" instead of silently guessing.
#
# Copy this file to ".env" (same folder) and fill in real values there.
# ".env" is gitignored and never leaves this machine; ".env.example" is the
# only one meant to be committed, so it must never contain a real secret.
#
# Variables already set elsewhere (MCP server registration in
# ~/.claude.json, or a real OS env var via `export`/`setx`) always win over
# this file - ".env" only fills in what's missing.
#
# Add new KEY=VALUE lines here as new tools/agents need their own config.

# --- servers/localllm_server.py (core/local_llm_client.py) ---

# Backend base URL, OpenAI-compatible (must end in /v1). No default in code -
# required. Example below uses loopback as a placeholder - replace with your
# actual OnFeather-free/Ollama/etc. host (e.g. a homelab LAN address).
LOCAL_LLM_BASE_URL=http://127.0.0.1:4141/v1

# Model name. No default in code - required. "auto" lets OnFeather-free
# route to whichever provider has quota headroom; "private" forces
# local-only (Ollama). A literal model tag (e.g. "llama3.1:8b") only works
# if you're pointed at a plain Ollama/llama-server instance that actually
# has that model pulled.
LOCAL_LLM_MODEL=auto

# Optional - required only for a non-localhost OnFeather-free instance
# (mandatory API key check on the server side). Without it every call
# returns "[local-llm unauthorized]". Corresponds to ONFEATHER_API_KEY
# server-side. Empty/unset is a valid "no key" state, unlike the two above.
LOCAL_LLM_API_KEY=

# --- Oracle connection for the "oracledb" MCP server (MCP Toolbox for
# Databases) - see core/oracle_config_sync.py and tools/oracledb.template.yaml.
# These are NOT read directly by that server (it's an external Go binary,
# not Python) - after changing any of the three below, run
# `.venv/bin/python core/oracle_config_sync.py` (or the --watch variant) to
# regenerate tools.yaml, which the running server hot-reloads on its own.

# host:port/service_name - no credentials in this one, they go below.
# If you're handed a .NET-style connection string
# (Data Source=(DESCRIPTION=...);USER ID=x;PASSWORD=y), split it: this var
# is only the HOST:PORT/SERVICE_NAME part.
ORACLE_CONNECTION_STRING=

ORACLE_USERNAME=
ORACLE_PASSWORD=

# Optional, only for Oracle Wallet/Kerberos setups (see template file).
# ORACLE_WALLET=
# ORACLE_USE_OCI=false
